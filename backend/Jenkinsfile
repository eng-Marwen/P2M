pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {
        SERVICE_NAME = 'backend'
        GIT_CREDENTIALS_ID = 'github-credentials'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                dir('backend') {
                    sh 'npm install'
                }
            }
        }

        stage('Run tests') {
            steps {
                dir('backend') {
                    sh 'npm test'
                }
            }
        }

        stage('Version and tag') {
            when {
                branch 'main'
            }
            steps {
                script {
                    sh 'git fetch --tags'

                    def latestTag = sh(
                        script: "git tag -l '${env.SERVICE_NAME}-v*' | sort -V | tail -n 1",
                        returnStdout: true
                    ).trim()
                    def version = latestTag ? latestTag.replaceFirst("^${env.SERVICE_NAME}-v", '') : '0.0.0'
                    def versionParts = version.tokenize('.')

                    if (versionParts.size() != 3 || versionParts.any { !(it ==~ /\d+/) }) {
                        error("Invalid version in Git tag: ${version}")
                    }

                    def major = versionParts[0] as int
                    def minor = versionParts[1] as int
                    def patch = versionParts[2] as int
                    def commitMessage = sh(
                        script: 'git log -1 --pretty=%B',
                        returnStdout: true
                    ).trim()
                    def normalizedCommitMessage = commitMessage.toLowerCase()
                    def newVersion = version

                    if (normalizedCommitMessage.startsWith('feat!:') ||
                        normalizedCommitMessage.contains('breaking change:')) {
                        newVersion = "${major + 1}.0.0"
                    } else if (normalizedCommitMessage.startsWith('feat:')) {
                        newVersion = "${major}.${minor + 1}.0"
                    } else if (normalizedCommitMessage.startsWith('fix:')) {
                        newVersion = "${major}.${minor}.${patch + 1}"
                    }

                    env.NEW_TAG = "${env.SERVICE_NAME}-v${newVersion}"
                    echo "Version: ${newVersion}"
                    echo "Tag: ${env.NEW_TAG}"
                }
            }
        }

        stage('Push Git tag') {
            when {
                branch 'main'
            }
            steps {
                script {
                    def tagExists = sh(
                        script: "git rev-parse '${env.NEW_TAG}' >/dev/null 2>&1",
                        returnStatus: true
                    ) == 0

                    if (tagExists) {
                        echo "Tag ${env.NEW_TAG} already exists, skipping creation."
                    } else {
                        withCredentials([
                            gitUsernamePassword(
                                credentialsId: env.GIT_CREDENTIALS_ID,
                                gitToolName: 'Default'
                            )
                        ]) {
                            sh """
                                git config user.name "jenkins"
                                git config user.email "jenkins@localhost"
                                git tag '${env.NEW_TAG}'
                                git push origin '${env.NEW_TAG}'
                            """
                        }
                        echo "Created and pushed tag ${env.NEW_TAG}."
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Backend tests passed and the pipeline stopped after tagging.'
        }
        failure {
            echo 'Backend pipeline failed.'
        }
    }
}
